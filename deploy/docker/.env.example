# Copy to .env and edit. `.env` is gitignored; never commit real secrets.
#
#   cp .env.example .env
#   docker compose --profile local up --build   # local, uses the Azurite block
#   docker compose up --build                    # Azure, uses the Azure block

# ---------------------------------------------------------------------------
# Blob storage connection string (ARGOX_STORAGE_AZURE_CONNECTION_STRING)
# ---------------------------------------------------------------------------
# LOCAL (default): Azurite's well-known development credentials. These are
# public documented values, not a secret. BlobEndpoint host is the Compose
# service name `azurite`. Run with `--profile local` so Azurite starts.
ARGOX_STORAGE_AZURE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;"
#
# AZURE: replace the line above with a real Storage account string, e.g.
#   az storage account show-connection-string -g <rg> -n <account> -o tsv
# ARGOX_STORAGE_AZURE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=<acct>;AccountKey=<key>;EndpointSuffix=core.windows.net"

# Container created lazily on first write.
ARGOX_STORAGE_AZURE_CONTAINER=argox

# ---------------------------------------------------------------------------
# Authentication (COL-09) — auth is ON; these are required for a usable stack
# ---------------------------------------------------------------------------
# Break-glass admin key used to mint the first real API key over HTTP.
# Generate a strong value, e.g.  openssl rand -hex 32
ARGOX_BOOTSTRAP_ADMIN_KEY=change-me-generate-a-strong-key

# OIDC for dashboard users (Microsoft Entra ID). All three together enable JWT
# auth; leave blank to run with API keys only.
#   ARGOX_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#   ARGOX_OIDC_AUDIENCE=<app-registration-client-id>
#   ARGOX_OIDC_JWKS_URI=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
ARGOX_OIDC_ISSUER=
ARGOX_OIDC_AUDIENCE=
ARGOX_OIDC_JWKS_URI=
# Entra app roles mapped to elevated scopes (optional).
ARGOX_OIDC_ADMIN_ROLE=
ARGOX_OIDC_POLICY_WRITE_ROLE=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
ARGOX_ENVIRONMENT=production
ARGOX_LOG_LEVEL=INFO

# CORS: only when a browser calls the Collector cross-origin (the dashboard
# proxies same-origin, so usually empty).
ARGOX_CORS_ORIGINS=

# Dashboard publish: host port and bind address (default loopback).
DASHBOARD_PORT=8080
DASHBOARD_BIND=127.0.0.1

# Where the dashboard's nginx proxies the API. Compose default below; on Azure
# Container Apps set COLLECTOR_UPSTREAM=http://collector (internal ingress).
COLLECTOR_UPSTREAM=http://collector:8000
