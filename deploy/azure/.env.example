# Argox on Azure — deploy variables.
# Copy to .env and edit. `.env` is gitignored; never commit real secrets.
#
#   cp .env.example .env
#   ./deploy.sh            # first deploy
#   ./update.sh code v2    # roll a new image
#
# Both scripts auto-source `.env` from this directory.

# ---------------------------------------------------------------------------
# Azure placement (resource group already exists; scripts do NOT create it)
# ---------------------------------------------------------------------------
RG=TFM-Aliando
LOC=swedencentral
ENV=argox-env

# ---------------------------------------------------------------------------
# Globally-unique names (lowercase, letters+digits). EDIT THESE before first
# deploy or creation collides with an existing global name.
# ---------------------------------------------------------------------------
ACR=argoxacraliando
STORAGE=argoxstgaliando

# Image tag for the current deploy. Use a fresh immutable tag every roll.
TAG=v1

# ---------------------------------------------------------------------------
# Auth — break-glass admin key (mints the first API key).
# Leave EMPTY and deploy.sh generates one and writes it back here.
# ---------------------------------------------------------------------------
ADMIN_KEY=

# ---------------------------------------------------------------------------
# OIDC for dashboard users (Microsoft Entra ID). All four together enable JWT
# auth; leave blank to run with API keys only.
# ---------------------------------------------------------------------------
ARGOX_OIDC_ISSUER=
ARGOX_OIDC_AUDIENCE=
ARGOX_OIDC_JWKS_URI=
ARGOX_OIDC_ADMIN_ROLE=

# ---------------------------------------------------------------------------
# Demo agent LLM backend (demo.sh / demo_agent.py). Pick ONE:
#
#  A) Azure OpenAI (recommended — same cloud as the deploy). Uses
#     AsyncAzureOpenAI; ENDPOINT is the resource ROOT (no /openai path), model =
#     the deployment name, and API_VERSION selects the data-plane API.
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-10-21
#
#  B) OpenAI directly:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
