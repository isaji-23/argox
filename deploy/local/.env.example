# Copy to .env and edit. `.env` is gitignored; never commit real secrets.
#
#   cp .env.example .env
#   ./run.sh

# ---------------------------------------------------------------------------
# LLM backend — pick ONE block (the agents call a live model and bill).
# ---------------------------------------------------------------------------
# Azure OpenAI (preferred). The endpoint must be the OpenAI-compatible v1
# surface, e.g. https://<resource>.openai.azure.com/openai/v1/ — the deployment
# name is passed as the model. See argox-project/examples/demo_azure_openai.py.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# OpenAI (fallback).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Mode: "local" (Docker stack on this machine) or "remote" (deployed stack).
# CLI arg wins: ./run.sh local | ./run.sh remote
# ---------------------------------------------------------------------------
DEMO_MODE=local

# ---------------------------------------------------------------------------
# LOCAL mode wiring (sensible defaults; usually leave as-is).
# ---------------------------------------------------------------------------
# Break-glass admin key for the local Collector. run.sh passes it to the Docker
# stack and uses it to mint the demo API key.
ARGOX_BOOTSTRAP_ADMIN_KEY=argox-local-admin

# Published dashboard port (the only externally reachable local service).
DASHBOARD_PORT=8080

# ---------------------------------------------------------------------------
# REMOTE mode wiring (only used by ./run.sh remote).
# ---------------------------------------------------------------------------
# Point straight at your deployed dashboard (proxies /api and /v1). If set, the
# az CLI lookup is skipped entirely.
# ARGOX_DASHBOARD_URL=https://<dashboard-fqdn>
#
# If ARGOX_DASHBOARD_URL is unset, run.sh resolves the FQDN from Azure Container
# Apps in this resource group:
# RG=TFM-Aliando
#
# Bring your own key to skip minting (needs read + ingest [+ policy-read]):
# ARGOX_COLLECTOR_API_KEY=
#
# Seeding the demo policy is OFF in remote mode by default (don't mutate a
# deployed fleet). Set true to seed argox-local-demo into the remote Collector.
# SEED_POLICY=false

# Demo backend bind host/port (serves the front + /api/run).
DEMO_HOST=127.0.0.1
DEMO_PORT=8090

# How often RemotePolicyClient re-polls the merged policy bundle (seconds).
ARGOX_POLICY_REFRESH_S=15
