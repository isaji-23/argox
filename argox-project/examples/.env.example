AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Optional: export spans to a running Argox Collector over OTLP/HTTP.
# Leave unset to keep the demo local-only (console + spans.jsonl).
# demo_e2e.sh sets these for you; set them by hand to target an existing
# Collector. ARGOX_COLLECTOR_API_KEY needs the `ingest` scope.
# ARGOX_COLLECTOR_ENDPOINT=http://localhost:8000/v1/traces
# ARGOX_COLLECTOR_API_KEY=argox_...
